{
  "name": "n8n-nodes-gemini-web-api",
  "version": "1.9.2",
  "description": "n8n community node for Google Gemini Web API using browser cookies (no API key required)",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "gemini",
    "google",
    "ai",
    "web-api",
    "cookie",
    "gems"
  ],
  "license": "MIT",
  "homepage": "https://github.com/darakcheeff/n8n-nodes-gemini-web",
  "author": {
    "name": "darakcheeff",
    "url": "https://github.com/darakcheeff"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/darakcheeff/n8n-nodes-gemini-web.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "dist/nodes/GeminiWeb/GeminiWeb.node.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "n8n-workflow": "^1.62.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.14.0"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/GeminiWeb/GeminiWeb.node.js"
    ],
    "credentials": [
      "dist/credentials/GeminiWebApi.credentials.js"
    ]
  }
}
